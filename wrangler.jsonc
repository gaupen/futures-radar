{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futures-radar",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FUTURES_KV",
      "id": "YOUR_FUTURES_KV_ID_HERE"
    }
  ],
  "triggers": {
    "crons": [
      "5 7 * * 1-5",
      "35 15 * * 1-5",
      "35 18 * * 1-5"
    ]
  }
}

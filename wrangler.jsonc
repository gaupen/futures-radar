{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futures-radar",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FUTURES_KV",
      "id": "d07049c664484c6d8e86b54300b84f51"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
